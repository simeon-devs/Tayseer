# PostgreSQL connection string. Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ChromaDB HTTP connection URL. Points to the chromadb Docker service.
CHROMADB_URL=

# Ollama API base URL. Change this to your RunPod H100 endpoint for the demo.
OLLAMA_URL=

# Ollama model name. Use qwen2.5:14b for development, qwen2.5:72b for demo.
OLLAMA_MODEL=

# Secret key used for token signing. Use a long random string in production.
SECRET_KEY=

# Runtime environment. One of: development, production.
ENVIRONMENT=

# Host that FastAPI binds to. Must be 0.0.0.0 so the Pi can reach the MacBook.
BACKEND_HOST=

# Port that FastAPI listens on.
BACKEND_PORT=

# Base URL the Next.js frontend uses for all API calls. On the Pi set this to the MacBook LAN IP.
NEXT_PUBLIC_API_URL=
